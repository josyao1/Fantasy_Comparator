# Sleeper (public API, no auth needed)
SLEEPER_USER_ID=410604513146195968

# Sleeper leagues to scan (comma-separated league_ids)
SLEEPER_LEAGUES=1395923684220235776,1395921205927608320

# ESPN private-league auth. Chrome > Cmd+Opt+I > Application >
# Cookies > https://fantasy.espn.com. Copy both values verbatim.
ESPN_S2=
SWID=

# ESPN leagues to scan (comma-separated leagueIds from the league URL)
ESPN_LEAGUES=

# Delivery: Gmail SMTP -> Verizon email-to-SMS gateway
NOTIFY_BACKEND=sms
GMAIL_USER=
GMAIL_APP_PW=
SMS_TO=

# Public URL where the HTML board is published (used in the text body)
BOARD_BASE_URL=

# Minutes before kickoff to fire each wave alert
LEAD_MINUTES=90
